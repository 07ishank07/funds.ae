node_modules/
backend/node_modules/
*.tmp

# Form submissions hold personal data (names, emails, messages). They must never
# be committed: the daily workflow runs `git add backend/data`, so keep these here.
backend/data/submissions/
backend/data/demo/submissions/

# Local secrets for the optional server. Document every variable in backend/.env.example instead.
.env
.env.*
!.env.example

# Personal Claude Code settings (shared project settings live in .claude/settings.json).
.claude/settings.local.json

.DS_Store
Thumbs.db

# Sanity Studio build output and local cache (studio/.env is covered by .env above).
studio/dist/
studio/.sanity/
# Generated by `npm run cms:seed`: re-create it rather than committing it.
studio/seed/

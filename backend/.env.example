# Environment for the optional Funds.ae server (npm run serve). Copy to .env or set these in
# your host's dashboard. None of this is needed for GitHub Pages hosting.
# .env files are git-ignored; never commit real values.

# --- Basics ---
PORT=8080
HOST=0.0.0.0
# demo | live. Overrides "mode" in config/settings.json.
FUNDSAE_MODE=demo

# --- Origins ---
# Comma-separated list of sites allowed to call the API from a browser, e.g.
# https://funds.ae,https://www.funds.ae. "*" allows any site to READ public data;
# forms (POST) never accept "*": they must come from this server's own origin or a listed one.
ALLOWED_ORIGINS=*
# "true" only when the server sits behind a proxy/load balancer you control that sets
# X-Forwarded-For and X-Forwarded-Host (Render, Fly.io, Railway, nginx...).
TRUST_PROXY=false
# "true" to send Strict-Transport-Security (only when the site is served over HTTPS).
HSTS=false

# --- Rate limits (per client IP, per process) ---
RATE_LIMIT_PER_MIN=120
STATIC_RATE_LIMIT_PER_MIN=600
# Form submissions. Defaults come from config/settings.json (submissions.writeRatePerMinute / writeRatePerHour).
# WRITE_RATE_LIMIT_PER_MIN=5
# WRITE_RATE_LIMIT_PER_HOUR=30

# --- Forms ---
# "false" turns the form endpoints off (the site then says forms are not connected).
SUBMISSIONS_ENABLED=true
# Secret used to hash client IP addresses before storing them with a submission.
# Set a long random value so hashes stay comparable across restarts, e.g. `openssl rand -hex 32`.
SUBMISSIONS_HASH_SALT=
# Bearer token for GET /api/v1/admin/submissions. At least 32 characters; leave empty to disable the route.
ADMIN_API_TOKEN=

# --- Website ---
# "false" to serve only the API (e.g. when the pages are on GitHub Pages or a CDN).
SERVE_STATIC=true
# Override the Content-Security-Policy sent with the HTML pages (see src/server/static.js).
# STATIC_CSP=

# --- Scheduler ---
# "true" to run the daily ingestion inside this process (instead of GitHub Actions).
ENABLE_SCHEDULER=false
# Hour of the daily run in UTC (3 = 07:00 UAE time).
INGEST_HOUR_UTC=3

# --- Paths (tests and advanced setups) ---
# FUNDSAE_DATA_DIR=
# FUNDSAE_API_DIR=
LOG_LEVEL=info

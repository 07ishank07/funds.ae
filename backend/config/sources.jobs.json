{
  "_help": [
    "Most big job boards (LinkedIn, Indeed, Bayt and similar) do not offer public RSS feeds, and their terms forbid scraping. Check a board's terms before adding it.",
    "The reliable, legal route is employer career pages that run on Greenhouse, Lever or Ashby. These systems publish public job APIs that are meant to be reused.",
    "How to find a board token: open the employer's careers page. If the job links contain boards.greenhouse.io/NAME, jobs.lever.co/NAME or jobs.ashbyhq.com/NAME, then NAME is the token.",
    "type: rss | greenhouse | lever | ashby. For greenhouse/lever/ashby, put the token in \"board\".",
    "requireUaeLocation: true keeps only jobs located in the UAE (or remote roles open to the UAE).",
    "relevanceFilter: true keeps only finance and investment roles. Use false for specialist finance employers where every role is relevant.",
    "Roles you post yourself go in jobs.manual.json, not here."
  ],
  "sources": [
    {
      "id": "example-greenhouse-employer",
      "name": "Example employer on Greenhouse",
      "type": "greenhouse",
      "board": "REPLACE_WITH_BOARD_TOKEN",
      "company": "Example Capital",
      "enabled": false,
      "requireUaeLocation": true,
      "relevanceFilter": false
    },
    {
      "id": "example-lever-employer",
      "name": "Example employer on Lever",
      "type": "lever",
      "board": "REPLACE_WITH_BOARD_TOKEN",
      "company": "Example Ventures",
      "enabled": false,
      "requireUaeLocation": true,
      "relevanceFilter": false
    },
    {
      "id": "example-ashby-employer",
      "name": "Example employer on Ashby",
      "type": "ashby",
      "board": "REPLACE_WITH_BOARD_TOKEN",
      "company": "Example Fintech",
      "enabled": false,
      "requireUaeLocation": true,
      "relevanceFilter": true
    },
    {
      "id": "example-rss-job-board",
      "name": "Example RSS job board",
      "type": "rss",
      "url": "https://example.com/jobs.rss",
      "enabled": false,
      "requireUaeLocation": true,
      "relevanceFilter": true,
      "titlePattern": "^(?<title>.+?) at (?<company>.+?)(?: \\((?<location>[^)]+)\\))?$"
    }
  ],

{
  "_help": [
    "To ADD a news source: copy one block inside \"sources\", give it a new unique \"id\", and change name/homepage/url.",
    "To REMOVE a source: set \"enabled\": false (keeps its history) or delete the block.",
    "region: \"uae\" nudges ambiguous stories towards the UAE category; \"global\" does not.",
    "focus: \"private-markets\" = specialist outlet (almost everything is relevant); \"general-business\" = stricter relevance filter.",
    "priority: 1 = most authoritative. When several outlets cover the same story, the lowest number becomes the lead link.",
    "allowImages: only use images the publisher itself puts in its RSS feed. Set false if a publisher's terms forbid hotlinking.",
    "verified: false means the URL follows the publisher's usual feed pattern but has not been confirmed. The first live run reports its status in api/v1/sources.json.",
    "demoSources are fictional and are only used when settings.json has \"mode\": \"demo\"."
  ],

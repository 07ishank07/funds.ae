# Copy to studio/.env (git-ignored) and fill in. These values are not secret:
# they are built into the Studio, which only works for people you invite.
# Project id: https://www.sanity.io/manage -> your project -> Project ID
SANITY_STUDIO_PROJECT_ID=
# "production" for the live site. Use "development" while you build or test schemas.
SANITY_STUDIO_DATASET=production
# Optional: the Studio's address when deployed, https://<host>.sanity.studio
SANITY_STUDIO_HOST=fundsae
